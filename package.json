{
  "name": "mecatol-ledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mecatol/api --filter @mecatol/web dev",
    "build": "pnpm --filter @mecatol/web build && pnpm --filter @mecatol/api build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @mecatol/api db:generate",
    "db:migrate": "pnpm --filter @mecatol/api db:migrate",
    "deploy": "pnpm --filter @mecatol/web build && pnpm --filter @mecatol/api deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11"
  }
}
